# ==============================================================================
# Loanwood Environment Configuration Example
# Copy this file to .env and customize values for your deployment environment
# ==============================================================================

# Security
DEBUG=True
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key-in-production

# PostgreSQL Database Connection URL
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://loanwood_user:loanwood_password@localhost:5432/loanwood_db

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
